# ==============================================================
# API Provider Keys & Configuration
# Set the keys for any provider you wish to use.
# You can switch between providers in real time using the app UI!
# ==============================================================

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# OpenRouter (Supports 100+ models, including free models)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_SITE_URL=http://localhost:8501
OPENROUTER_SITE_NAME=ChatSynth

# Groq (Ultra-fast Llama & open models)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Gemini AI Studio API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# NVIDIA NIM (NVIDIA Hosted API)
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
